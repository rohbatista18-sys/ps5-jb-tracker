# Copy to .env.local and fill in. Never prefix secrets with NEXT_PUBLIC_.

# Azure OpenAI (required for AI summaries; without them a neutral fallback is shown)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=

# GitHub (optional; raises the API limit from 60 to 5000 req/h). Use a fine-grained token with no scopes.
GITHUB_TOKEN=

# Upstash Redis (optional; presence and rate limits fall back to per-instance memory).
# The Vercel Marketplace integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>". Generate with: openssl rand -hex 32
CRON_SECRET=

# Page views counted before the site tracked them (added to the shown total). Optional.
PAGEVIEWS_BASELINE=

# Supabase (optional; when set, counters and presence live here instead of Redis).
# Project URL (https://<ref>.supabase.co) and the server-side secret key (sb_secret_...). Run supabase/001_counters.sql once.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
